# Base URL of the deployed Django backend (Vercel). Used to build the game-data
# endpoints the server fetches round data from for the games NOT on the questions store
# (see src/gameEndpoints.js).
API_BASE_URL=https://<your-backend-project>.vercel.app

# Comma-separated allowed browser origins for Socket.IO / CORS (your deployed frontend).
CORS_ORIGINS=https://nba-trivia-minigames.online,http://localhost:5173

# Port to listen on. Most hosts inject this automatically; 4000 is the local default.
PORT=4000

# Optional: enable the Socket.IO Redis adapter for multi-instance broadcasting.
# REDIS_URL=rediss://default:<pass>@<host>:<port>

# Public base URL of the Supabase Storage bucket holding the pre-generated questions
# (same value as QUESTIONS_PUBLIC_BASE in backend/.env). src/questions.js reads
# <base>/questions/manifest.json to deal career-path, who-are-ya, contexto, superdraft and the
# turn games (tictactoe, imposter). Unset -> those games can't deal a round.
QUESTIONS_PUBLIC_BASE=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
