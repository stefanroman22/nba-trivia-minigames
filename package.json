{
  "name": "nba-minigames",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "proxy": "http://127.0.0.1:8000",
  "scripts": {
    "copy:data": "node scripts/copy-data.mjs",
    "predev": "node scripts/dev-env.mjs",
    "dev": "npm run copy:data && node scripts/dev.mjs",
    "build": "npm run copy:data && next build",
    "check:games": "node scripts/check-game-results.mjs",
    "check:legal": "node scripts/check-legal-config.mjs",
    "check:ids": "node scripts/check-constraint-ids.mjs",
    "check:seen": "node scripts/check-seen.mjs",
    "check:review-rounds": "node scripts/check-review-rounds.mjs",
    "check:award-seasons": "node scripts/check-award-seasons.mjs",
    "check:daily-flow": "node scripts/check-daily-flow.mjs",
    "lint": "eslint . && npm run check:games && npm run check:ids && npm run check:legal && npm run check:seen && npm run check:review-rounds && npm run check:award-seasons && npm run check:daily-flow",
    "test:game-data": "node --experimental-strip-types scripts/test-game-data.mjs",
    "test:daily-game": "node --experimental-strip-types scripts/test-daily-game.mjs",
    "test:in-app-browser": "node --experimental-strip-types scripts/test-in-app-browser.mjs",
    "test:daily-countdown": "node --experimental-strip-types scripts/test-daily-countdown.mjs",
    "test:www-points": "node --experimental-strip-types scripts/test-www-points.mjs",
    "test:game-scoring": "node --experimental-strip-types scripts/test-game-scoring.mjs",
    "test:ban": "node --experimental-strip-types scripts/test-ban.mjs",
    "test:award": "node --experimental-strip-types scripts/test-award.mjs",
    "test:name-lookup": "node --experimental-strip-types scripts/test-name-lookup.mjs",
    "test:ranks": "node --experimental-strip-types scripts/test-ranks.mjs",
    "test:ladder": "node --experimental-strip-types scripts/test-ladder.mjs",
    "team": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/team-run.ps1",
    "chrome:debug": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File scripts/chrome-debug.ps1",
    "ui:check": "node scripts/ui-check/run.mjs",
    "ui:verify": "node scripts/ui-check/verify.mjs",
    "ui:report": "node scripts/ui-check/report.mjs",
    "ui:probe": "node scripts/ui-check/probe.mjs",
    "ui:selftest": "node node_modules/@playwright/test/cli.js test -c scripts/ui-check --project selftest",
    "logic:check": "node scripts/logic-check/run.mjs",
    "logic:live": "node scripts/logic-check/run.mjs --suite live --live",
    "logic:selftest": "node node_modules/@playwright/test/cli.js test -c scripts/logic-check --project selftest",
    "test:seo": "node --test \"scripts/seo/**/*.test.mjs\"",
    "seo:audit": "node scripts/seo/audit.mjs",
    "ui:audit": "node scripts/ui-audit.mjs --label desktop --width 1100 --height 900 && node scripts/ui-audit.mjs --label laptop --width 854 --height 694 && node scripts/ui-audit.mjs --label mobile --width 390 --height 844",
    "cards:render": "node scripts/game-cards/render.mjs",
    "cards:finish": "node scripts/game-cards/finish.mjs",
    "cards:generate": "node scripts/game-cards/generate.mjs",
    "cards:sources": "node scripts/game-cards/fetch-sources.mjs",
    "cards:sheet": "node scripts/game-cards/sheet.mjs",
    "cards:apply": "node scripts/game-cards/apply.mjs",
    "preview": "next start -p 4173",
    "lh": "lighthouse http://localhost:4173 --output=json --output=html --output-path=./.lighthouse/desktop --chrome-flags=--headless=new --quiet --preset=desktop",
    "lh:mobile": "lighthouse http://localhost:4173 --output=json --output=html --output-path=./.lighthouse/mobile --chrome-flags=--headless=new --quiet",
    "lh:ci": "lhci collect --numberOfRuns=5 --url=http://localhost:4173 --settings.preset=desktop",
    "engine": "node .claude/use-profile.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.90.12",
    "chart.js": "^4.5.1",
    "copy-to-clipboard": "^3.3.3",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^16.3.4",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.19",
    "sweetalert2": "^11.6.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.5.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
