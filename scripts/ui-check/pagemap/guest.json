{
  "_about": "Guest suite locators: landing page, footer, game page (rail, chips, idle, aside), modals, 404/admin/profile guest views. No data-testid exists in the app; these are role/name, aria-labels, visible text and stable class names.",
  "shell": { "css": ".app-shell" },
  "main": { "css": "main.page" },
  "nav": { "css": "nav.nav3" },
  "templateWrap": { "css": "#root > div" },
  "heroGrain": { "css": ".hero-grain" },
  "heroPlayToday": { "role": "button", "name": "Play today's game", "exact": false },
  "heroBrowse": { "role": "button", "name": "Browse all games", "exact": true },
  "gamesSection": { "css": "#games-grid" },
  "gamesSearch": { "role": "textbox", "name": "Search games" },
  "gameTiles": { "css": "#games-grid .gtile" },
  "gameTilesEmpty": { "css": "#games-grid .games-empty" },
  "leaderboardSection": { "css": "#leaderboard" },
  "leaderboardViewAll": { "css": "#leaderboard button.lb-viewall" },
  "guestPanel": { "css": ".guest-panel" },
  "guestPanelCta": { "css": ".guest-panel-cta" },
  "feedbackBandBtn": { "css": "button.feedback-band-btn" },
  "feedbackFab": { "css": "button.feedback-fab" },

  "footer": { "css": "footer.site-footer" },
  "footerGamesNav": { "css": "footer.site-footer nav[aria-label='Games']" },
  "footerGameLinks": { "css": "footer.site-footer nav[aria-label='Games'] a" },
  "footerPrivacy": { "css": "footer.site-footer nav[aria-label='Legal'] a[href='/privacy']" },
  "footerTerms": { "css": "footer.site-footer nav[aria-label='Legal'] a[href='/terms']" },
  "footerContact": { "css": "footer.site-footer nav[aria-label='Legal'] a[href^='mailto:']" },

  "railList": { "css": "aside.rail" },
  "railItems": { "css": "aside.rail .rail-item" },
  "railItemActive": { "css": "aside.rail .rail-item.is-active" },
  "railStrip": { "css": ".rail-strip" },
  "railChips": { "css": ".rail-strip .rail-chip" },
  "railChipActive": { "css": ".rail-strip .rail-chip.is-active" },
  "gameTitle": { "css": "section.stage-col h1" },
  "gameIdle": { "css": ".stage-col .idle" },
  "gameIdleThumb": { "css": ".stage-col .idle .idle-thumb" },
  "gamePlay": { "css": ".stage-col .idle-action button" },
  "gameInfoBtn": { "role": "button", "name": "How to play", "exact": true },
  "mpAside": { "css": "aside.game-aside" },
  "mpInfoBtn": { "role": "button", "name": "How multiplayer works", "exact": true },
  "mpLoginBtn": { "css": "aside.game-aside button:text-is('Log in to play online')" },
  "mpFriendBtn": { "css": "aside.game-aside .mp-row button:has-text('Play with a friend')" },
  "mpPlay1v1Btn": { "css": "aside.game-aside .mp-row button:has-text('Play 1v1')" },
  "mpRow": { "css": "aside.game-aside .mp-row" },

  "modalBackdrop": { "css": ".modal-backdrop" },
  "modalPanel": { "css": ".modal-backdrop .modal-panel" },
  "modalTitle": { "css": ".modal-panel .modal-title" },
  "modalClose": { "css": ".modal-panel button.modal-close" },
  "authTabs": { "css": ".modal-panel .auth-tabs" },
  "authTabSignup": { "css": ".modal-panel .auth-tabs button[role='tab']:has-text('Sign up')" },
  "authTabLogin": { "css": ".modal-panel .auth-tabs button[role='tab']:has-text('Log in')" },
  "segThumb": { "css": ".modal-panel .seg-thumb" },
  "fabZ": { "css": ".feedback-fab" },
  "drawerPanel": { "css": ".drawer-panel" },

  "notFoundCode": { "css": "h1:text-is('404')" },
  "notFoundTitle": { "role": "heading", "name": "Nothing here yet" },
  "notFoundHome": { "css": "button:text-is('Back to games')" },

  "adminOnly": { "text": "Admins only", "exact": true },
  "adminBack": { "role": "button", "name": "Back to the games", "exact": true },
  "adminChecking": { "text": "Checking access…", "exact": true },
  "adminTabs": { "css": ".admin-tabs, [role='tablist'][aria-label='Admin sections']" },
  "adminTable": { "css": "table" },
  "profileEmpty": { "css": "section.ps-empty" },
  "profilePrompt": { "text": "Log in to see and manage your profile.", "exact": true },
  "profileLoginBtn": { "css": "section.ps-empty button:text-is('Log in / Sign up')" },

  "privacyH1": { "css": "main article h1:text-is('Privacy Policy')" },
  "termsH1": { "css": "main article h1:text-is('Terms of Service')" }
}
