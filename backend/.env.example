# Backend environment variables.
# Local dev needs NONE of these set: defaults are sqlite + DEBUG=True + localhost.
# Set these in production (e.g. the Render dashboard).

# --- Security ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
# RENDER_EXTERNAL_HOSTNAME is injected automatically by Render and added to ALLOWED_HOSTS.

# --- CORS / CSRF (comma-separated) ---
# ADDITIVE: merged onto settings.FRONTEND_ORIGINS, never replacing it. Leave both unset
# unless you are adding an origin the code doesn't already list (e.g. a custom domain).
CORS_ALLOWED_ORIGINS=https://your-extra-origin.example.com
CSRF_TRUSTED_ORIGINS=https://your-extra-origin.example.com

# --- Database ---
# Supabase Postgres connection string. Unset -> local sqlite.
# Use the direct/session connection (port 5432) as below. If you instead use the
# transaction pooler (port 6543, PgBouncer), set conn_max_age=0 in settings.py.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Google OAuth (existing) ---
CLIENT_ID=
CLIENT_SECRET=

# --- Questions store (Supabase Storage) ---
# Read by trivia/questions/storage.py (StorageConfig.from_env); ALL SIX are required by the
# maintain_questions / upload_dataset commands, which raise ImproperlyConfigured if any is
# missing. Run those offline (they upload via the S3 API, which needs boto3 from
# requirements-publish.txt); the request path never needs them.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<storage-region>
SUPABASE_S3_ACCESS_KEY_ID=replace-with-storage-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-storage-s3-secret-access-key
SUPABASE_STORAGE_BUCKET=<bucket-name>
# Public HTTP base of that bucket (no auth); reads use <base>/datasets/manifest.json and
# <base>/questions/manifest.json. A trailing slash is stripped. Same value the
# multiplayer server needs in its own env.
QUESTIONS_PUBLIC_BASE=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>

# --- Game-data publisher (manage.py publish_game_data_v3; offline / GitHub Actions only) ---
# Public base URL of the static data host. The publisher diffs against
# <base>/manifest.json; unset = no previous publish (everything is new). In CI it
# comes from the DATA_PUBLIC_BASE repo variable.
DATA_PUBLIC_BASE=https://<data-host>
